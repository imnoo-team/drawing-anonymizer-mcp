{
  "name": "drawing-anonymizer-mcp",
  "version": "0.1.0",
  "description": "MCP server that anonymizes technical-drawing PDFs: finds company names, logos, people, addresses, phone numbers, emails and URLs, masks them and writes a flattened, metadata-free PDF or an expiring share link. Powers https://drawing-anonymizer.imnoo.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "drawing-anonymizer",
    "anonymize-pdf",
    "pdf-redaction",
    "redact-pdf",
    "pdf-anonymization",
    "drawing-masking",
    "technical-drawing",
    "engineering-drawing",
    "title-block",
    "nda",
    "gdpr",
    "data-privacy",
    "white-out",
    "manufacturing",
    "cnc",
    "imnoo"
  ],
  "mcpName": "com.imnoo/drawing-anonymizer",
  "license": "MIT",
  "author": "Imnoo AG (https://www.imnoo.com)",
  "homepage": "https://drawing-anonymizer.imnoo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnoo-team/drawing-anonymizer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/imnoo-team/drawing-anonymizer-mcp/issues"
  },
  "type": "module",
  "bin": {
    "drawing-anonymizer-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
